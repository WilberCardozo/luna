rules_version = '2';

// Un solo cielo, sin inicio de sesión: colección "memories".
// Cualquiera con el enlace puede leer y agregar, pero nadie puede eliminar
// ni reescribir un recuerdo: "borrar" solo lo marca como deleted = true,
// así que siempre se puede recuperar desde la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /memories/{memoryId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['text', 'photo', 'date', 'deleted', 'video', 'poster'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 600
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 40
        && request.resource.data.deleted == false
        && (request.resource.data.photo == null
            || (request.resource.data.photo is string
                && request.resource.data.photo.size() < 900000))
        // video: dirección del archivo en Firebase Storage; poster: portada pequeña
        && (!('video' in request.resource.data) || request.resource.data.video == null
            || (request.resource.data.video is string
                && request.resource.data.video.size() < 2000
                && request.resource.data.video.matches('https://firebasestorage[.]googleapis[.]com/.*')))
        && (!('poster' in request.resource.data) || request.resource.data.poster == null
            || (request.resource.data.poster is string
                && request.resource.data.poster.size() < 300000));

      // solo se permite cambiar "deleted" (ocultar o volver a mostrar)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
        && request.resource.data.deleted is bool;

      allow delete: if false;
    }
  }
}
