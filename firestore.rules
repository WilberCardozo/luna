rules_version = '2';

// Cada persona solo puede leer y escribir sus propios recuerdos:
// users/{su uid}/memories/{id}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/memories/{memoryId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'photo', 'date'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 600
        && request.resource.data.date is string
        && (request.resource.data.photo == null
            || (request.resource.data.photo is string
                && request.resource.data.photo.size() < 900000));
    }
  }
}
